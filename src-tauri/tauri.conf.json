{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClassKernel",
  "version": "0.1.0",
  "identifier": "com.classkernel.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClassKernel",
        "visible": false,
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0RDIzRjU2QzA3RjMzNjAKUldSZ00zL0FWai9TWk1HR2hlRExBOHRxaXY3MEVWbVVESmNyWHE5QS83QXlFaVJ2dW44M0JPZlgK",
      "endpoints": [
        "https://github.com/J4ckR4bbit/ClassKernel/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
