{
  "name": "classkernel-science",
  "private": true,
  "version": "0.1.0",
  "description": "Science teaching tools for the board, as a website: chemistry reference, titration, galvanic cell, graph plotters, graph paper.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "docs:screenshots": "playwright test -c scripts/screenshots/playwright.config.ts",
    "build:desktop": "tsc && vite build --outDir ../classkernel/dist/science --emptyOutDir"
  },
  "dependencies": {
    "@classkernel/ui": "*",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  }
}
