{
  "name": "classkernel-workspace",
  "private": true,
  "description": "ClassKernel (classroom management, a Windows desktop app) and ClassKernel Science (science teaching tools, a website), with the look they share.",
  "type": "module",
  "workspaces": [
    "packages/ui",
    "apps/classkernel",
    "apps/science"
  ],
  "scripts": {
    "dev": "npm run dev -w classkernel",
    "dev:science": "npm run dev -w classkernel-science",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "tauri": "npm run tauri -w classkernel --"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.11"
  }
}
